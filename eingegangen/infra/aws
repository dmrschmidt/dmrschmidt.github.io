#!/usr/bin/env bash
# aws CLI against the eingegangen account, isolated from ~/.aws (work config). Same trick as overslam.
#   eingegangen/infra/aws login                  sign in via browser (short-lived, re-run when expired)
#   eingegangen/infra/aws sts get-caller-identity
set -euo pipefail
mkdir -p ~/.aws-eingegangen
export AWS_CONFIG_FILE=~/.aws-eingegangen/config
export AWS_SHARED_CREDENTIALS_FILE=~/.aws-eingegangen/credentials
export AWS_PROFILE=eingegangen
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_DEFAULT_PROFILE AWS_DEFAULT_REGION
export AWS_REGION=us-east-1  # CloudFront certificates live here, so the app stack does too
exec aws "$@"
